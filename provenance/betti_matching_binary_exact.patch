+    if ((input.flags() & py::array::c_style) != py::array::c_style) {
+        throw invalid_argument(
+            "betti_matching_binary_exact requires C-contiguous uint8 inputs");
+    }
+    const auto *values = static_cast<const value_t *>(input.data());
+    for (py::ssize_t index = 0; index < input.size(); ++index) {
+        if (values[index] > 1) {
+            throw invalid_argument(
+                "betti_matching_binary_exact requires binary uint8 values {0, 1}");
+        }
+    }
+    auto typed = input.cast<TypedInputVolume>();
+    for (py::ssize_t dimension = 0; dimension < typed.ndim(); ++dimension) {
+        if (typed.shape(dimension) >= dim3::Cube::kCoordinateLimit) {
+            throw invalid_argument(
+                "betti_matching_binary_exact supports dimensions up to 1023 voxels");
+        }
+    }
+    return typed;
 }
 
