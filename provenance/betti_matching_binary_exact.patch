+vector<array<size_t, 3>> BettiMatching::getMatchingCounts() const {
+    const auto countUnmatched = [](const vector<Pair> &pairs,
+                                   const unordered_map<uint64_t, bool> &isMatched) {
+        size_t count = 0;
+        for (const auto &pair : pairs) {
+            const auto match = isMatched.find(pair.birth.identity());
+            if (match == isMatched.end() || !match->second) {
+                ++count;
+            }
+        }
+        return count;
+    };
+
+    vector<array<size_t, 3>> counts;
+    counts.reserve(3);
+    for (uint8_t dimension = 0; dimension < 3; ++dimension) {
+        counts.push_back({matches[dimension].size(),
+                          countUnmatched(pairs0[dimension], isMatched0[dimension]),
+                          countUnmatched(pairs1[dimension], isMatched1[dimension])});
+    }
+    return counts;
+}
